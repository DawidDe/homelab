{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboardApproval": false,

  "flux": {
    "managerFilePatterns": [
      "/fluxcd/apps/.+\\.ya?ml$/",
      "/fluxcd/infrastructure/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["flux"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    }
  ]
}